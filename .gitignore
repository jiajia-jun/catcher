.idea/
.vscode/

# 运行时数据：数据库、日志、失败响应留底
data/
*.db
*.db-shm
*.db-wal

# 构建产物
build/bin/
frontend/node_modules/
node_modules/

# 前端构建输出；只保留 embed 所需的占位文件
frontend/dist/*
!frontend/dist/.gitkeep

# Wails 根据 package.json 生成的校验文件
frontend/package.json.md5

# 手工调接口的 Apipost 导出，可能含真实凭据
catcher.json

# 本地文档与设计草稿，仅保留在工作区
/docs/
/draft/
/CLAUDE.md

# Wails NSIS 构建时下载的 WebView2 引导程序
build/windows/installer/tmp/

# 发布资产（安装包、便携包）
build/release/

# logo 源文件；只跟踪 README 引用的那一份
/logo/*
!/logo/logo-wordmark-1024x256.png